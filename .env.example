# Local configuration for AI Code Review script (scripts/ai_pr_review.py)
# Copy this file to `.env` and fill in your API key:
#   cp .env.example .env

# Your Google AI Studio (Gemini) API Key
LLM_API_KEY=your_gemini_api_key_here

# Optional: Preferred model (e.g. gemini-flash-latest, gemini-2.0-flash, gemini-1.5-flash)
# LLM_MODEL=gemini-flash-latest

# Optional: GitHub repository (auto-detected in GitHub Actions or git remote)
# GITHUB_REPOSITORY=tibagni/LogViewer

# Optional: Comma-separated GitHub usernames eligible for auto-approval on LGTM
# AUTO_APPROVE_AUTHORS=tibagni
